# Copy to .env locally. Do not commit real values.
# XAI_API_KEY is injected in preview/production; set locally only if you run Grok/Imagine yourself.
XAI_API_KEY=
DATABASE_URL=
BETTER_AUTH_SECRET=
FFMPEG=/usr/local/bin/ffmpeg
STAMP_URL=https://stamps.sheundresses.com
STAMP_SECRET=

# Owner — production never elects the first signup.
# INITIAL_ADMIN_EMAIL defaults to the designated operator inbox in code.
# Override here only if you need a different owner. Never commit the live password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USER_ID=
BOOTSTRAP_SECRET=


# Public site — apex is canonical. www should 301 here.
PUBLIC_SITE_URL=https://sheundresses.com
BETTER_AUTH_URL=https://sheundresses.com
VITE_PUBLIC_HOSTNAME=sheundresses.com

# Payments — public checkout requires API_KEY + IPN_SECRET. HMAC + amount/currency match before grant.
# NOWPAYMENTS_IPN_URL is optional when PUBLIC_SITE_URL (or BETTER_AUTH_URL) is set; derived as {site}/api/payments/ipn.
# NOWPayments merchant terms currently exclude US/EU/UK residents and citizens.
# Confirm eligibility in writing before live US settlement.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://sheundresses.com/api/payments/ipn

# Paid vault storage — prefer Cloudflare R2 (Worker binding HMULS_VAULT → hmuls-vault).
# Plain vars (OK on Worker as text):
R2_ACCOUNT_ID=8e4acc97dafd9496df937662d07aa0d5
R2_BUCKET=hmuls-vault
# Secret: Cloudflare API token with R2 object read/write (REST fallback when binding not yet attached).
# Alias R2_CF_API_TOKEN is also accepted.
CLOUDFLARE_API_TOKEN=
# R2_CF_API_TOKEN=
# Object keys: vault/<basename> (e.g. vault/crv_1.jpg), stamps/<userId>/<shotId>.png
# Binding is declared in wrangler.toml ([[r2_buckets]] binding=HMULS_VAULT).

# Optional legacy / fallback: private Vercel Blob (Hobby transfer caps can suspend the store).
# Vault originals and stamps MUST be put with access:"private". HMAC pathnames are not access control.
# Teasers may use public access. Prefer R2 for paid vault in production.
BLOB_READ_WRITE_TOKEN=

# Auth outbound mail (password reset). Cloudflare Email Routing cannot send.
# AgentMail inbox id is typically the full address (e.g. you@agentmail.to).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=