# Copy to .env locally. Do not commit real values.
# XAI_API_KEY is injected in preview/production; set locally only if you run Grok/Imagine yourself.
XAI_API_KEY=
DATABASE_URL=
BETTER_AUTH_SECRET=
FFMPEG=/usr/local/bin/ffmpeg

# Payments — invoices never self-settle from the browser.
# NOWPayments IPN HMAC is required before public collectors can be granted.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=
# Optional fixed deposit addresses if you are not using NOWPayments create-payment.
PAY_ADDRESS_BTC=
PAY_ADDRESS_ETH=
PAY_ADDRESS_USDT=
PAY_ADDRESS_SOL=
