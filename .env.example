# Copy to .env locally. Do not commit real values.
# XAI_API_KEY is injected in preview/production; set locally only if you run Grok/Imagine yourself.
XAI_API_KEY=
DATABASE_URL=
BETTER_AUTH_SECRET=
FFMPEG=/usr/local/bin/ffmpeg
STAMP_URL=https://stamps.sheundresses.com
STAMP_SECRET=

# Owner — production never elects the first signup.
# INITIAL_ADMIN_EMAIL defaults to the designated operator inbox in code.
# Override here only if you need a different owner. Never commit the live password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USER_ID=
BOOTSTRAP_SECRET=


# Public site — apex is canonical. www should 301 here.
PUBLIC_SITE_URL=https://sheundresses.com
BETTER_AUTH_URL=https://sheundresses.com
VITE_PUBLIC_HOSTNAME=sheundresses.com

# Payments — public checkout requires API_KEY + IPN_SECRET. HMAC + amount/currency match before grant.
# NOWPAYMENTS_IPN_URL is optional when PUBLIC_SITE_URL (or BETTER_AUTH_URL) is set; derived as {site}/api/payments/ipn.
# NOWPayments merchant terms currently exclude US/EU/UK residents and citizens.
# Confirm eligibility in writing before live US settlement.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_URL=https://sheundresses.com/api/payments/ipn

# Durable object storage for Studio originals + stamp cache (required for new paid media on Vercel).
# Create a private Blob store. Vault originals and stamps MUST be put with access:"private".
# HMAC pathnames are not access control. Teasers may use public access.
BLOB_READ_WRITE_TOKEN=